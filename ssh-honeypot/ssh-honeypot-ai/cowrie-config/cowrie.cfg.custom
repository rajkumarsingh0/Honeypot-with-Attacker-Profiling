# cowrie.cfg -- CUSTOM SETTINGS ONLY
#
# This is NOT the full Cowrie config file. Cowrie's default config
# (cowrie/src/cowrie/data/etc/cowrie.cfg.dist) is very long; this file
# documents only the sections we changed from defaults, for reference.
#
# To set up a fresh install:
#   1. cp cowrie/src/cowrie/data/etc/cowrie.cfg.dist cowrie/etc/cowrie.cfg
#   2. cp cowrie/src/cowrie/data/etc/userdb.example cowrie/etc/userdb.txt
#   3. Apply the changes below to cowrie/etc/cowrie.cfg

[ssh]
# Cowrie listens on 2222, never on port 22 directly (never run as root).
# Real port 22 traffic is redirected to this port via iptables --
# see scripts/setup_port_redirect.sh
listen_endpoints = tcp:2222:interface=0.0.0.0

[honeypot]
hostname = svr04

[output_mysql]
enabled = true
host = localhost
database = cowrie
username = cowrie
# Password is read from environment / set manually -- DO NOT commit a
# real password here. See ../.env.example for the credential this
# corresponds to (DB_WRITE_PASSWORD).
password = CHANGE_ME
port = 3306
